---
import Layout from '../layouts/Layout.astro'
import ToolCard from '../components/ToolCard.astro'
import { categories, getFeaturedTools } from '../lib/tools-data'

const featured = getFeaturedTools()
const activeCategories = categories.filter(c => c.toolCount > 0)
---

<Layout title="告诉我你想干嘛，我帮你选工具">
  <!-- Hero -->
  <section class="mx-auto max-w-7xl px-4 py-16 text-center">
    <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
      告诉我你想干嘛，<br class="sm:hidden" /><span class="bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">我帮你选工具</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600">
      做视频、写文案、建网站、跑营销——每个场景都有现成的 AI 工具组合方案。
    </p>
    <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a href="/category" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-lg font-medium text-white shadow-lg transition hover:bg-indigo-700 hover:shadow-xl">
        找到你的方案
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <form action="/search" method="get" class="relative w-full max-w-md sm:w-auto sm:flex-1 sm:max-w-sm">
        <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          name="q"
          placeholder="或者直接搜索..."
          class="w-full rounded-xl border border-gray-300 py-3 pl-12 pr-4 shadow-sm transition focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"
        />
      </form>
    </div>
    <div class="mt-6 flex flex-wrap justify-center gap-2 text-sm text-gray-500">
      <span>热门场景:</span>
      {activeCategories.slice(0, 5).map((cat) => (
        <a href={`/category/${cat.slug}`} class="rounded-full bg-gray-100 px-3 py-1 hover:bg-indigo-50 hover:text-indigo-600 transition">
          {cat.icon} {cat.name}
        </a>
      ))}
    </div>
  </section>

  <!-- Categories -->
  <section class="mx-auto max-w-7xl px-4 pb-12">
    <h2 class="mb-6 text-2xl font-semibold text-gray-900">📂 分类浏览</h2>
    <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {categories.map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 transition hover:border-indigo-200 hover:shadow-md"
        >
          <span class="text-2xl">{cat.icon}</span>
          <div>
            <div class="font-medium text-gray-900">{cat.name}</div>
            <div class="text-sm text-gray-500">{cat.toolCount} 个工具</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Tools -->
  <section class="mx-auto max-w-7xl px-4 pb-16">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-2xl font-semibold text-gray-900">🔥 精选工具</h2>
      <a href="/category" class="text-sm text-indigo-600 hover:text-indigo-700">查看全部 →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((tool) => (
        <ToolCard
          name={tool.name}
          descriptionShort={tool.descriptionShort}
          url={`/tool/${tool.slug}`}
          logoUrl={tool.logoUrl}
          pricingModel={tool.pricingModel}
          categoryPrimary={tool.categoryPrimary}
          chineseSupport={tool.chineseSupport}
          tags={tool.tags}
          editorScore={tool.editorScore}
        />
      ))}
    </div>
  </section>
</Layout>
