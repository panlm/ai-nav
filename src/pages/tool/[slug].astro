---
import Layout from '../../layouts/Layout.astro'
import JsonLdTool from '../../components/JsonLdTool.astro'
import { getAllTools, getToolBySlug, getCategoryBySlug } from '../../lib/tools-data'

export function getStaticPaths() {
  const tools = getAllTools()
  return tools.map((t) => ({
    params: { slug: t.slug },
  }))
}

const { slug } = Astro.params
const tool = getToolBySlug(slug!)

if (!tool) {
  return Astro.redirect('/404')
}

const category = getCategoryBySlug(tool.categoryPrimary)

const pricingLabels: Record<string, string> = {
  free: '免费', freemium: '免费增值', paid: '付费',
  enterprise: '企业版', 'open-source': '开源', 'contact-sales': '联系销售',
}
const pricingColors: Record<string, string> = {
  free: 'bg-green-100 text-green-700', freemium: 'bg-blue-100 text-blue-700',
  paid: 'bg-orange-100 text-orange-700', enterprise: 'bg-red-100 text-red-700',
  'open-source': 'bg-purple-100 text-purple-700', 'contact-sales': 'bg-gray-100 text-gray-700',
}
const chineseLabels: Record<string, { label: string; class: string }> = {
  native: { label: '中文原生', class: 'bg-red-100 text-red-700' },
  supported: { label: '支持中文', class: 'bg-orange-100 text-orange-700' },
  'english-only': { label: '仅英文', class: 'bg-gray-100 text-gray-600' },
}
const platformIcons: Record<string, string> = {
  Web: '🌐', Mac: '🍎', Win: '🪟', Linux: '🐧',
  iOS: '📱', Android: '🤖', API: '🔌',
  'Chrome Extension': '🧩', 'wechat-mini': '💬',
  'VS Code': '💻', 'JetBrains': '🔧', 'Slack': '💬', 'Zapier': '⚡',
}

function formatTraffic(visits: number): string {
  if (visits >= 1_000_000) return `${(visits / 1_000_000).toFixed(1)}M`
  if (visits >= 1_000) return `${(visits / 1_000).toFixed(0)}K`
  return String(visits)
}

const trendLabels: Record<string, { label: string; color: string; icon: string }> = {
  growing: { label: '增长中', color: 'text-green-600', icon: '📈' },
  stable: { label: '稳定', color: 'text-blue-600', icon: '➡️' },
  declining: { label: '下降中', color: 'text-orange-600', icon: '📉' },
}

const fundingLabels: Record<string, string> = {
  'seed': '种子轮', 'series-a': 'A 轮', 'series-b': 'B 轮', 'series-c': 'C 轮',
  'series-d': 'D 轮', 'ipo': '已上市', 'acquired': '已收购', 'bootstrapped': '自筹',
  'public': '上市公司',
}
---

<Layout title={`${tool.name} — AI工具详情`} description={tool.descriptionShort}>
  <JsonLdTool
    name={tool.name}
    description={tool.descriptionShort}
    url={tool.url}
    logoUrl={tool.logoUrl}
    pricingModel={tool.pricingModel}
    categoryPrimary={tool.categoryPrimary}
    editorScore={tool.editorScore}
    platforms={tool.platforms}
  />
  <div class="mx-auto max-w-4xl px-4 pt-6">
    <nav class="flex text-sm text-gray-500">
      <a href="/" class="hover:text-indigo-600">首页</a>
      <span class="mx-2">/</span>
      <a href={`/category/${tool.categoryPrimary}`} class="hover:text-indigo-600">{category?.name || tool.categoryPrimary}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{tool.name}</span>
    </nav>
  </div>

  <article class="mx-auto max-w-4xl px-4 py-8">
    <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
      <!-- Header -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-5">
        <div class="flex items-center gap-4 sm:contents">
          {tool.logoUrl ? (
            <img src={tool.logoUrl} alt={tool.name} width="64" height="64" loading="lazy" decoding="async" class="h-16 w-16 shrink-0 rounded-xl object-cover" />
          ) : (
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-2xl font-bold text-indigo-600">
              {tool.name.charAt(0)}
            </div>
          )}
          <div class="sm:hidden text-right ml-auto">
            <div class="text-3xl font-bold text-indigo-600">{tool.editorScore}</div>
            <div class="text-xs text-gray-500">编辑评分</div>
          </div>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl font-bold text-gray-900">{tool.name}</h1>
            <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${pricingColors[tool.pricingModel]}`}>
              {pricingLabels[tool.pricingModel]}
            </span>
            <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${chineseLabels[tool.chineseSupport].class}`}>
              {chineseLabels[tool.chineseSupport].label}
            </span>
            {tool.openSource && (
              <span class="rounded-full bg-purple-100 px-2.5 py-0.5 text-xs font-medium text-purple-700">开源</span>
            )}
            {tool.affiliate?.hasProgram && (
              <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700">💰 联盟推广</span>
            )}
          </div>
          <p class="mt-1 text-sm text-gray-500">{category?.name}</p>
        </div>
        <div class="hidden sm:block text-right">
          <div class="text-3xl font-bold text-indigo-600">{tool.editorScore}</div>
          <div class="text-xs text-gray-500">编辑评分</div>
        </div>
      </div>

      <!-- Short Description -->
      <div class="mt-6 rounded-lg bg-indigo-50 p-4">
        <p class="text-indigo-900">{tool.descriptionShort}</p>
      </div>

      <!-- Long Description -->
      {tool.descriptionFull && tool.descriptionFull !== tool.descriptionShort && (
        <div class="mt-6">
          <h2 class="text-lg font-semibold text-gray-900">详细介绍</h2>
          <p class="mt-2 leading-relaxed text-gray-700">{tool.descriptionFull}</p>
        </div>
      )}

      <!-- Use Cases -->
      {tool.useCases.length > 0 && (
        <div class="mt-6">
          <h2 class="text-lg font-semibold text-gray-900">🎯 使用场景</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {tool.useCases.map((uc) => (
              <span class="rounded-full bg-indigo-50 px-3 py-1.5 text-sm font-medium text-indigo-700">{uc}</span>
            ))}
          </div>
        </div>
      )}

      <!-- Ratings -->
      {tool.ratings && (
        <div class="mt-6">
          <h2 class="text-lg font-semibold text-gray-900">⭐ 评分详情</h2>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {[
              { label: '综合评分', value: tool.ratings.overall },
              { label: '易用性', value: tool.ratings.easeOfUse },
              { label: '性价比', value: tool.ratings.valueForMoney },
              { label: '输出质量', value: tool.ratings.outputQuality },
            ].map((item) => (
              <div class="flex items-center gap-3">
                <span class="w-20 text-sm text-gray-600 shrink-0">{item.label}</span>
                <div class="flex-1 h-2.5 rounded-full bg-gray-200 overflow-hidden">
                  <div
                    class="h-full rounded-full bg-indigo-500"
                    style={`width: ${(item.value / 5) * 100}%`}
                  />
                </div>
                <span class="w-8 text-sm font-semibold text-gray-900 text-right">{item.value}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Pricing Detail -->
      {tool.pricingDetail && (
        <div class="mt-6">
          <h2 class="text-lg font-semibold text-gray-900">💳 价格方案</h2>
          <div class="mt-3">
            {tool.pricingDetail.startingPrice > 0 && (
              <p class="text-gray-700">
                起始价格: <span class="font-semibold text-indigo-600">${tool.pricingDetail.startingPrice}</span>/月
                {tool.pricingDetail.currency && tool.pricingDetail.currency !== 'USD' && (
                  <span class="text-gray-500 text-sm ml-1">({tool.pricingDetail.currency})</span>
                )}
              </p>
            )}
            {tool.pricingDetail.freeTierLimits && (
              <p class="mt-1 text-sm text-gray-600">免费额度: {tool.pricingDetail.freeTierLimits}</p>
            )}
            {tool.pricingDetail.plans && tool.pricingDetail.plans.length > 0 && (
              <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {tool.pricingDetail.plans.map((plan: any) => (
                  <div class="rounded-lg border border-gray-200 p-4">
                    <h4 class="font-semibold text-gray-900">{plan.name}</h4>
                    {plan.price_monthly ? (
                      <p class="mt-1 text-lg font-bold text-indigo-600">${plan.price_monthly}<span class="text-sm font-normal text-gray-500">/月</span></p>
                    ) : (
                      <p class="mt-1 text-sm text-gray-500">联系销售</p>
                    )}
                    {plan.features && (
                      <ul class="mt-2 space-y-1">
                        {plan.features.map((f: string) => (
                          <li class="flex items-start gap-1.5 text-sm text-gray-600">
                            <span class="text-green-500 mt-0.5">✓</span>
                            <span>{f}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      )}

      <!-- Info Grid -->
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div class="min-w-0">
          <h3 class="text-sm font-medium text-gray-500">支持平台</h3>
          <div class="mt-2 flex flex-wrap gap-2">
            {tool.platforms.map((p) => (
              <span class="inline-flex items-center gap-1 rounded-lg bg-gray-100 px-3 py-1 text-sm">
                <span>{platformIcons[p] || '📦'}</span>
                <span>{p}</span>
              </span>
            ))}
          </div>
        </div>
        <div class="min-w-0">
          <h3 class="text-sm font-medium text-gray-500">标签</h3>
          <div class="mt-2 flex flex-wrap gap-2">
            {tool.tags.map((tag) => (
              <span class="rounded-lg bg-indigo-50 px-3 py-1 text-sm text-indigo-600">{tag}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- Model Base -->
      {tool.modelBase.length > 0 && (
        <div class="mt-6">
          <h3 class="text-sm font-medium text-gray-500">基础模型</h3>
          <div class="mt-2 flex flex-wrap gap-2">
            {tool.modelBase.map((m) => (
              <span class="rounded-lg bg-violet-50 px-3 py-1 text-sm font-medium text-violet-700">{m}</span>
            ))}
          </div>
        </div>
      )}

      <!-- Workflow Tags -->
      {tool.workflowTags.length > 0 && (
        <div class="mt-4">
          <h3 class="text-sm font-medium text-gray-500">适用工作流</h3>
          <div class="mt-2 flex flex-wrap gap-2">
            {tool.workflowTags.map((w) => (
              <span class="rounded-lg bg-amber-50 px-3 py-1 text-sm text-amber-700">{w}</span>
            ))}
          </div>
        </div>
      )}

      <!-- Company Info -->
      {tool.company && (
        <div class="mt-6 rounded-lg bg-gray-50 p-4">
          <h3 class="text-sm font-medium text-gray-500 mb-2">🏢 公司信息</h3>
          <div class="grid gap-2 sm:grid-cols-2 text-sm">
            <div><span class="text-gray-500">公司:</span> <span class="text-gray-900">{tool.company.name}</span></div>
            <div><span class="text-gray-500">国家:</span> <span class="text-gray-900">{tool.company.country}</span></div>
            <div><span class="text-gray-500">成立年份:</span> <span class="text-gray-900">{tool.company.foundedYear}</span></div>
            <div><span class="text-gray-500">融资阶段:</span> <span class="text-gray-900">{fundingLabels[tool.company.fundingStage] || tool.company.fundingStage}</span></div>
          </div>
        </div>
      )}

      <!-- Traffic Estimate -->
      {tool.trafficEstimate && tool.trafficEstimate.monthlyVisits > 0 && (
        <div class="mt-4 flex items-center gap-4 rounded-lg bg-gray-50 p-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">📊 月访问量</h3>
            <p class="text-xl font-bold text-gray-900">{formatTraffic(tool.trafficEstimate.monthlyVisits)}</p>
          </div>
          {trendLabels[tool.trafficEstimate.trafficTrend] && (
            <div>
              <span class={`text-sm font-medium ${trendLabels[tool.trafficEstimate.trafficTrend].color}`}>
                {trendLabels[tool.trafficEstimate.trafficTrend].icon} {trendLabels[tool.trafficEstimate.trafficTrend].label}
              </span>
            </div>
          )}
        </div>
      )}

      <!-- Affiliate Info -->
      {tool.affiliate?.hasProgram && (
        <div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 p-4">
          <h3 class="text-sm font-medium text-emerald-800 mb-1">💰 联盟推广计划</h3>
          <div class="text-sm text-emerald-700">
            <span>佣金: <strong>{tool.affiliate.commissionRate}</strong></span>
            {tool.affiliate.cookieDays > 0 && (
              <span class="ml-4">Cookie: <strong>{tool.affiliate.cookieDays} 天</strong></span>
            )}
          </div>
        </div>
      )}

      {tool.verifiedAt && (
        <div class="mt-4 text-xs text-gray-400">
          ✅ 最后验证: {tool.verifiedAt}
        </div>
      )}

      <!-- CTA -->
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={tool.url}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 font-medium text-white transition hover:bg-indigo-700"
        >
          访问官网
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <button class="rounded-xl border border-gray-300 px-6 py-3 font-medium text-gray-700 transition hover:bg-gray-50">
          ❤️ 收藏
        </button>
      </div>
    </div>
  </article>
</Layout>
