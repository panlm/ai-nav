---
import Layout from '../layouts/Layout.astro'
---

<Layout title="页面未找到" description="您访问的页面不存在">
  <div class="flex min-h-[60vh] flex-col items-center justify-center px-4 text-center">
    <div class="text-8xl font-bold text-indigo-200">404</div>
    <h1 class="mt-4 text-2xl font-bold text-gray-900">页面未找到</h1>
    <p class="mt-2 text-gray-500">您访问的页面不存在或已被移除。</p>
    <a
      href="/"
      class="mt-6 inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 font-medium text-white transition hover:bg-indigo-700"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      返回首页
    </a>
  </div>
</Layout>
