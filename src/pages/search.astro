---
import Layout from '../layouts/Layout.astro'
import ToolCard from '../components/ToolCard.astro'
import { getAllTools } from '../lib/tools-data'

const allTools = getAllTools()
// Pre-serialize tool data for client-side search
const toolSearchData = allTools.map(t => ({
  slug: t.slug,
  name: t.name,
  descriptionShort: t.descriptionShort,
  tags: t.tags,
  useCases: t.useCases,
  categoryPrimary: t.categoryPrimary,
}))
---

<Layout title="搜索 AI 工具" description="搜索和发现最好的 AI 工具">
  <section class="mx-auto max-w-7xl px-4 py-8">
    <!-- Search Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">🔍 搜索 AI 工具</h1>
      <form id="search-form" class="relative max-w-2xl">
        <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="search-input"
          type="text"
          name="q"
          placeholder="输入工具名称、功能、标签..."
          autocomplete="off"
          class="w-full rounded-xl border border-gray-300 py-3 pl-12 pr-4 shadow-sm transition focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 text-lg"
        />
      </form>
      <p id="result-count" class="mt-3 text-sm text-gray-500">找到 {allTools.length} 个工具</p>
    </div>

    <!-- Tool Grid -->
    <div id="tool-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {allTools.map((tool) => (
        <div
          class="tool-card-wrapper"
          data-slug={tool.slug}
        >
          <ToolCard
            name={tool.name}
            descriptionShort={tool.descriptionShort}
            url={`/tool/${tool.slug}`}
            logoUrl={tool.logoUrl}
            pricingModel={tool.pricingModel}
            categoryPrimary={tool.categoryPrimary}
            chineseSupport={tool.chineseSupport}
            tags={tool.tags}
            editorScore={tool.editorScore}
          />
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden py-16 text-center text-gray-500">
      <svg class="mx-auto h-16 w-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <p class="text-lg font-medium">未找到相关工具</p>
      <p class="mt-2 text-sm">试试其他关键词</p>
    </div>
  </section>

  <!-- Client-side search data -->
  <script id="tool-search-data" type="application/json" set:html={JSON.stringify(toolSearchData)} />

  <script>
    // Parse search data
    const toolData = JSON.parse(document.getElementById('tool-search-data')!.textContent!)

    const searchInput = document.getElementById('search-input') as HTMLInputElement
    const resultCount = document.getElementById('result-count')!
    const toolGrid = document.getElementById('tool-grid')!
    const emptyState = document.getElementById('empty-state')!
    const allCards = toolGrid.querySelectorAll<HTMLElement>('.tool-card-wrapper')

    // Read initial query from URL
    const params = new URLSearchParams(window.location.search)
    const initialQuery = params.get('q') || ''
    if (initialQuery) {
      searchInput.value = initialQuery
      filterTools(initialQuery)
    }

    // Focus the search input
    searchInput.focus()

    // Real-time filtering
    searchInput.addEventListener('input', () => {
      filterTools(searchInput.value)
      // Update URL without reload
      const url = new URL(window.location.href)
      if (searchInput.value) {
        url.searchParams.set('q', searchInput.value)
      } else {
        url.searchParams.delete('q')
      }
      history.replaceState(null, '', url.toString())
    })

    function filterTools(query: string) {
      const q = query.toLowerCase().trim()
      let visibleCount = 0

      allCards.forEach((card, index) => {
        if (!q) {
          card.classList.remove('hidden')
          visibleCount++
          return
        }

        const data = toolData[index]
        const searchText = [
          data.name,
          data.descriptionShort,
          data.categoryPrimary,
          ...data.tags,
          ...data.useCases,
        ].join(' ').toLowerCase()

        if (searchText.includes(q)) {
          card.classList.remove('hidden')
          visibleCount++
        } else {
          card.classList.add('hidden')
        }
      })

      resultCount.textContent = `找到 ${visibleCount} 个工具`
      emptyState.classList.toggle('hidden', visibleCount > 0)
      toolGrid.classList.toggle('hidden', visibleCount === 0)
    }
  </script>
</Layout>
