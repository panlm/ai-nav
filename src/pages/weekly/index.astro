---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

const weekly = await getCollection('weekly')

// Sort by weekNumber descending
const sortedWeekly = weekly.sort((a, b) => b.data.weekNumber - a.data.weekNumber)

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date)
}
---

<Layout title="周报" description="每周追踪 AI 工具圈的新生与死亡，工具更新、模型发布、行业动态一网打尽">
  <div class="mx-auto max-w-4xl px-4 py-8">
    <!-- Header -->
    <header class="mb-12 text-center">
      <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">AI 工具周报</h1>
      <p class="mt-4 text-lg text-gray-600">
        每周追踪 AI 工具圈的新生与死亡，帮你省去刷 100 个信息源的时间
      </p>
    </header>

    <!-- Weekly List -->
    <div class="space-y-6">
      {sortedWeekly.map((report) => (
        <article class="group rounded-xl border border-gray-200 bg-white p-6 transition hover:border-indigo-200 hover:shadow-md">
          <a href={`/weekly/${report.id}`} class="block">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class="inline-flex items-center gap-1 rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-medium text-indigo-700">
                    #{report.data.weekNumber}
                  </span>
                  <span class="text-sm text-gray-500">{report.data.dateRange}</span>
                </div>
                <h2 class="text-xl font-semibold text-gray-900 group-hover:text-indigo-600 transition-colors">
                  {report.data.title}
                </h2>
                <p class="mt-2 text-gray-600 line-clamp-2">
                  {report.data.description}
                </p>
                {report.data.highlights.length > 0 && (
                  <ul class="mt-4 space-y-1">
                    {report.data.highlights.slice(0, 3).map((highlight: string) => (
                      <li class="flex items-start gap-2 text-sm text-gray-500">
                        <span class="text-indigo-400 mt-0.5">•</span>
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <time datetime={report.data.publishedAt.toISOString()} class="text-sm text-gray-400 whitespace-nowrap">
                {formatDate(report.data.publishedAt)}
              </time>
            </div>
          </a>
        </article>
      ))}
    </div>

    {sortedWeekly.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-500">暂无周报</p>
      </div>
    )}
  </div>
</Layout>
