---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

const articles = await getCollection('articles')

// Sort by publishedAt descending
const sortedArticles = articles.sort((a, b) =>
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
)

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date)
}
---

<Layout title="文章" description="AI 工具使用指南、深度评测和场景方案">
  <div class="mx-auto max-w-4xl px-4 py-8">
    <!-- Header -->
    <header class="mb-12 text-center">
      <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">文章</h1>
      <p class="mt-4 text-lg text-gray-600">
        AI 工具使用指南、深度评测、场景化解决方案
      </p>
    </header>

    <!-- Articles List -->
    <div class="space-y-8">
      {sortedArticles.map((article) => (
        <article class="group rounded-xl border border-gray-200 bg-white p-6 transition hover:border-indigo-200 hover:shadow-md">
          <a href={`/articles/${article.id}`} class="block">
            <h2 class="text-xl font-semibold text-gray-900 group-hover:text-indigo-600 transition-colors">
              {article.data.title}
            </h2>
            <p class="mt-2 text-gray-600 line-clamp-2">
              {article.data.description}
            </p>
            <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-gray-500">
              <span>{article.data.author}</span>
              <span>·</span>
              <time datetime={article.data.publishedAt.toISOString()}>
                {formatDate(article.data.publishedAt)}
              </time>
              {article.data.relatedTools.length > 0 && (
                <>
                  <span>·</span>
                  <span class="text-indigo-600">
                    涉及 {article.data.relatedTools.length} 个工具
                  </span>
                </>
              )}
            </div>
            {article.data.keywords.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {article.data.keywords.slice(0, 3).map((keyword: string) => (
                  <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs text-gray-600">
                    {keyword}
                  </span>
                ))}
              </div>
            )}
          </a>
        </article>
      ))}
    </div>

    {sortedArticles.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-500">暂无文章</p>
      </div>
    )}
  </div>
</Layout>
