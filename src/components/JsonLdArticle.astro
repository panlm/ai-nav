---
interface Props {
  title: string
  description: string
  publishedAt: Date
  updatedAt?: Date
  author: string
  url: string
  image?: string
}

const { title, description, publishedAt, updatedAt, author, url, image } = Astro.props

const jsonLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url,
  datePublished: publishedAt.toISOString(),
  author: {
    '@type': 'Organization',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'AI Nav',
  },
}

if (updatedAt) {
  jsonLd.dateModified = updatedAt.toISOString()
}

if (image) {
  jsonLd.image = image
}
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
