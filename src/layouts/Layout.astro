---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  image?: string
  type?: 'website' | 'article'
}

const {
  title,
  description = '发现最好的 AI 工具 — 精选导航、评测、场景方案',
  image = '/og-default.png',
  type = 'website'
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL(image, Astro.site)
const fullTitle = `${title} | AI Nav`
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#4f46e5" />
    <title>{fullTitle}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="AI Nav" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Plausible Analytics — update data-domain when custom domain is set -->
    <script defer data-domain="ai-nav-liart.vercel.app" src="https://plausible.io/js/script.js"></script>

    <!-- Google Search Console verification — replace content with actual verification code -->
    <meta name="google-site-verification" content="REPLACE_WITH_VERIFICATION_CODE" />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
    <header class="sticky top-0 z-50 border-b border-gray-200 bg-white/80 backdrop-blur-sm">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
        <a href="/" class="text-xl font-bold text-indigo-600">🧭 AI Nav</a>
        <!-- Desktop nav -->
        <div class="hidden sm:flex items-center gap-4">
          <a href="/category" class="text-sm text-gray-600 hover:text-gray-900">分类</a>
          <a href="/articles" class="text-sm text-gray-600 hover:text-gray-900">文章</a>
          <a href="/weekly" class="text-sm text-gray-600 hover:text-gray-900">周报</a>
          <a href="/search" class="flex items-center gap-1 text-sm text-gray-600 hover:text-gray-900" title="搜索">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            搜索
          </a>
          <a href="/submit" class="rounded-lg bg-indigo-600 px-3 py-1.5 text-sm text-white hover:bg-indigo-700">提交工具</a>
        </div>
        <!-- Mobile hamburger menu -->
        <details class="relative sm:hidden">
          <summary class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg hover:bg-gray-100 list-none [&::-webkit-details-marker]:hidden">
            <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </summary>
          <div class="absolute right-0 top-full mt-2 w-48 rounded-xl border border-gray-200 bg-white py-2 shadow-lg">
            <a href="/search" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              搜索
            </a>
            <a href="/category" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">分类</a>
            <a href="/articles" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">文章</a>
            <a href="/weekly" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">周报</a>
            <a href="/submit" class="block mx-4 mt-2 rounded-lg bg-indigo-600 px-3 py-1.5 text-center text-sm text-white hover:bg-indigo-700">提交工具</a>
          </div>
        </details>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-16 border-t border-gray-200 py-8">
      <div class="mx-auto max-w-7xl px-4">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 text-sm text-gray-500">
          <div>
            <h4 class="font-semibold text-gray-700 mb-2">🧭 AI Nav</h4>
            <p>发现最好的 AI 工具</p>
          </div>
          <div>
            <h4 class="font-semibold text-gray-700 mb-2">导航</h4>
            <ul class="space-y-1">
              <li><a href="/category" class="hover:text-indigo-600">分类</a></li>
              <li><a href="/search" class="hover:text-indigo-600">搜索</a></li>
              <li><a href="/articles" class="hover:text-indigo-600">文章</a></li>
              <li><a href="/weekly" class="hover:text-indigo-600">周报</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-gray-700 mb-2">更多</h4>
            <ul class="space-y-1">
              <li><a href="/submit" class="hover:text-indigo-600">提交工具</a></li>
              <li><a href="/about" class="hover:text-indigo-600">关于我们</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-6 border-t border-gray-100 pt-4 text-center text-sm text-gray-400">
          © 2026 AI Nav. Built with Astro + Supabase.
        </div>
      </div>
    </footer>
  </body>
</html>
);
    </script>
  </body>
</html>
